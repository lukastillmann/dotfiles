{
    "name": "custom-snippets",
    "engines": {
        "vscode": "^1.11.0"
    },
    "contributes": {
        "snippets": [
            {
                "language": [
                    "plaintext",
                    "markdown",
                    "tex",
                    "html",
                    "global",
                    "all"
                ],
                "path": "./snippets/global.json"
            },
            {
                "language": "lua",
                "path": "./snippets/lua/lua.json"
            },
            {
                "language": "vue",
                "path": "./snippets/javascript/vue.json"
            },
            {
                "language": ["markdown", "rmd"],
                "path": "./snippets/markdown.json"
            }
        ]
    }
}

